                                    </item>

                                    <!-- Row 1, Column 1: Controller Connect Button -->
                                    <item row="1" column="1">
                                        <widget class="QPushButton" name="control_controller_connect">
                                            <property name="text">
                                                <string>CONNECT</string>
                                            </property>
                                            <property name="checkable">
                                                <bool>true</bool>
                                            </property>
                                            <property name="styleSheet">
                                                <string notr="true">
                                                    background-color: green;
