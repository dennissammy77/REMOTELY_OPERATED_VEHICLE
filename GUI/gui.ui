                                        font-weight: bold;
                                        font-size: 20px
                                        padding: 10px;
                                    </string>
                                </property>
                                <layout class="QGridLayout" name="gridLayout_4">

                                    <!-- Row 0, Column 1: ROV Connect Button -->
                                    <item row="0" column="0">
                                        <widget class="QLabel" name="label_3">
